# Copy to .env. Every setting is an environment variable with the AUTOEDIT_ prefix.
AUTOEDIT_ENV=dev
AUTOEDIT_DATABASE_URL=sqlite:///./data/autoedit.db
AUTOEDIT_REDIS_URL=redis://localhost:6379/0
AUTOEDIT_QUEUE_MODE=rq                 # or "inline" to run jobs inside the API (no Redis needed)
AUTOEDIT_STORAGE_BACKEND=local         # or "s3" (Cloudflare R2, MinIO, AWS)
# AUTOEDIT_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AUTOEDIT_S3_BUCKET=autoedit
# AUTOEDIT_S3_ACCESS_KEY_ID=
# AUTOEDIT_S3_SECRET_ACCESS_KEY=

# Test phase: billing is off, everyone gets the unrestricted "test" plan. Set to true to enable plans.
AUTOEDIT_BILLING_ENABLED=false
AUTOEDIT_TEST_MAX_TOTAL_RAW_S=1800

# Plan limits (PRD 16), used only when billing is enabled. Limits apply to the TOTAL raw length of all clips in a project.
AUTOEDIT_FREE_MAX_TOTAL_RAW_S=180
AUTOEDIT_PAID_MAX_TOTAL_RAW_S=1800
AUTOEDIT_MAX_CLIPS=20
AUTOEDIT_FREE_PROJECTS_PER_MONTH=3
AUTOEDIT_RETENTION_DAYS=30

# Claude models (used from M3 on).
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_SMART=
ANTHROPIC_API_KEY=
